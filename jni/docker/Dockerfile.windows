ARG BASE_IMAGE=ubuntu:22.04@sha256:076e7bf82319619f28dd0aa9c02ab34b055ad37100395b4f49a2ffba04fb5e11
FROM ${BASE_IMAGE}

ARG TOOLCHAIN_URL
ARG TOOLCHAIN_SHA256

ENV DEBIAN_FRONTEND=noninteractive TZ=UTC PYTHONDONTWRITEBYTECODE=1

RUN apt-get update -o Acquire::Retries=5 \
 && apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
      ca-certificates curl git patch python3 unzip xz-utils \
 && rm -rf /var/lib/apt/lists/*

RUN test -n "$TOOLCHAIN_URL" && test -n "$TOOLCHAIN_SHA256" \
 && curl -fsSL --retry 3 -o /tmp/llvm-mingw.tar.xz "$TOOLCHAIN_URL" \
 && echo "$TOOLCHAIN_SHA256  /tmp/llvm-mingw.tar.xz" | sha256sum -c - \
 && mkdir /opt/llvm-mingw \
 && tar -xJf /tmp/llvm-mingw.tar.xz -C /opt/llvm-mingw --strip-components=1 \
 && rm /tmp/llvm-mingw.tar.xz

ENV PATH=/opt/llvm-mingw/bin:$PATH
